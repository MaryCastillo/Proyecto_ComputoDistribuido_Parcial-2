        </mxCell>
        <mxCell id="n20" value="estado = COMPLETADA; guardar RESPUESTA (CSV); Mostrar el resultado" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
